{
  "name": "OutdatedFinding",
  "type": "object",
  "properties": {
    "investigation_id": {
      "type": "string"
    },
    "claim": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "source_title": {
      "type": "string"
    },
    "date_reference": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "needs_verification"
      ],
      "default": "needs_verification"
    },
    "recommendation": {
      "type": "string"
    }
  },
  "required": [
    "investigation_id",
    "claim"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}