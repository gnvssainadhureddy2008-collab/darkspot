{
  "name": "Contradiction",
  "type": "object",
  "properties": {
    "investigation_id": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "claim_a": {
      "type": "string"
    },
    "source_a_id": {
      "type": "string"
    },
    "source_a_title": {
      "type": "string"
    },
    "claim_b": {
      "type": "string"
    },
    "source_b_id": {
      "type": "string"
    },
    "source_b_title": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "next_steps": {
      "type": "string"
    }
  },
  "required": [
    "investigation_id",
    "topic"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}